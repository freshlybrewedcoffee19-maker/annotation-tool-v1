  "narrative": {
    "northStar": "Footage, labels and a human check",
    "overview": "The existing nAIve Physics identity is the authority: warm cream, paper surfaces, dark brown text, restrained red and the typed brand. Real footage provides the imagery. The opening page uses the approved Relay composition; large rounded actions carry the approved Build Sprint button treatment.\n\nThe workspace gives video the largest working area, keeps microphone and labels nearby, and uses quieter bordered surfaces for precise data. Review gives one segment a focused card. The landing composition is a surface choice, not a required layout for every screen.",
    "keyCharacteristics": [
      "Warm cream canvas and paper surfaces.",
      "Red actions and dark ink text.",
      "Rounded controls with clear selected states.",
      "Real footage at the centre of the work.",
      "Quiet borders for dense data, soft depth for media."
    ],
    "rules": [
      {
        "name": "The Brand Continuity Rule",
        "body": "Extend the cream, paper, ink and red identity on new surfaces; keep review colours tied to their stated meaning.",
        "section": "colors"
      },
      {
        "name": "The Task Hierarchy Rule",
        "body": "Give the current question or footage decision the strongest title; keep storage details and secondary navigation quieter.",
        "section": "typography"
      },
      {
        "name": "The Media Depth Rule",
        "body": "Reserve diffuse lift for footage and prominent sprint actions; organise dense working data with borders and tonal surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the cream, paper, ink and red identity.",
      "Do keep video and voice controls adjacent on laptops and stacked on phones.",
      "Do pair review colours with written status labels.",
      "Do retain visible keyboard focus and reduced-motion support.",
      "Do keep dense segment data readable in a horizontally scrollable table."
    ],
    "donts": [
      "Don't replace the established Segoe UI family without an explicit identity decision.",
      "Don't turn the landing footage fan into a rule for every screen.",
      "Don't use review green as a second general brand accent.",
      "Don't introduce hard offset shadows into this soft media treatment."
    ],
    "guidedWorkspace": {
      "progress": "Actual saved records and microphone/boundary/export events drive progress; skipped tasks do not count complete. Saved work and review transitions provide written rewards.",
      "preference": "Browser workspace guide preference; no account-wide synchronization.",
      "layout": "Named coloured destinations left, source-proportion contained footage and timeline central, microphone right; one contextual task strip.",
      "reducedMotion": "Reward entrance animation disabled; Show me where still explicitly requests smooth scrolling.",
      "pending": "General tracking, detection, masks and team review remain explicitly Pending with manual alternatives.",
      "scope": "Approved 6 October 2026 extension; earlier unrelated surface guidance remains preserved.",
      "direction": "CVAT precision, Canva feature discovery and Candy Crush microtasks within the Cheddar Vox brand."
    }
  }
